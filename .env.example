# AI Hub workshop environment.
#
# YOU DO NOT NEED A KEY TO SET THIS UP. Keys are handed out on the day. Copy
# this file to .env, set AI_PROVIDER to the vendor you expect to use, and run
# Workshop.Verify.Run(): it checks everything except the three provider steps,
# including that this container can reach that vendor over HTTPS. Expect
# 7 OK and 3 WAIT. Add the key on the day, recreate the container, expect 10 OK.
#
# ---------------------------------------------------------------------------
# AI Hub workshop — LLM provider configuration
#
# Copy to .env (which is git-ignored) and fill in ONE provider's key:
#     cp .env.example .env
#
# docker compose passes these into the IRIS container, where ObjectScript
# reads them with $SYSTEM.Util.GetEnviron(). Running in a container is what
# makes this easy: on a Windows host, $SYSTEM.Util.GetEnviron() can only see
# MACHINE-level variables (an elevated PowerShell + a real IRIS restart), and
# we sidestep that entirely.
#
# Environment variables are read when the IRIS process starts, so after
# editing this file:
#     docker compose up -d --force-recreate iris
# ---------------------------------------------------------------------------

# Which provider the workshop agents use. One of:
#   anthropic | openai | gemini | azureopenai | bedrock | deepseek | ollama
AI_PROVIDER=openai

# Model id. Must be one your key can actually reach.
AI_MODEL=gpt-4o

# --- Supply the key for the provider named above ---------------------------
# Only the matching one is needed; leave the rest blank.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Azure OpenAI also needs these:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# --- Offline fallback -------------------------------------------------------
# Ollama is reached through the "openai" provider via its OpenAI-compatible
# API, NOT a dedicated provider name. From inside the container the host is
# host.docker.internal, not localhost.
#   AI_PROVIDER=ollama
#   AI_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ---------------------------------------------------------------------------
# NOTE: a key in a file is a CLASSROOM shortcut. The production route is the
# IRIS Config Store + Wallet, where the agent carries only a reference:
#
#   Parameter PROVIDERCONFIG = "@{config:AI.LLM.ProductionLLM}";
#
# and the secret lives behind a secret:// Wallet entry with Use/Edit resources
# on it. Module D builds exactly that, and revokes the resource to show the
# failure.
# ---------------------------------------------------------------------------

# --- Outbound DNS ----------------------------------------------------------
# Only needed if your network blocks Docker's default resolvers (1.1.1.1 /
# 8.8.8.8). Symptom: the agent fails with a ProviderError "dns error ... Name
# or service not known" while the host resolves the same name fine.
# Find yours with:  Get-DnsClientServerAddress -AddressFamily IPv4
#DNS_SERVER=10.0.0.1

